{
	"name": "@op-engineering/op-s2",
	"version": "0.0.0",
	"description": "Modern secure storage for React Native",
	"main": "./lib/commonjs/index.js",
	"module": "./lib/module/index.js",
	"types": "./lib/typescript/src/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.tsx",
			"types": "./lib/typescript/src/index.d.ts",
			"default": "./lib/module/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"lib",
		"android",
		"ios",
		"cpp",
		"*.podspec",
		"Package.swift",
		"op-s2-spm-prefix.h",
		"!ios/build",
		"!android/build",
		"!android/gradle",
		"!android/gradlew",
		"!android/gradlew.bat",
		"!android/local.properties",
		"!**/__tests__",
		"!**/__fixtures__",
		"!**/__mocks__",
		"!**/.*"
	],
	"codegenConfig": {
		"name": "OPS2Spec",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.op.s2"
		}
	},
	"scripts": {
		"example": "yarn workspace @op-engineering/op-s2-example",
		"prepare": "bob build",
		"test": "jest",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
		"format:check": "oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
		"clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
		"release": "./bump-version.sh && npm publish"
	},
	"keywords": [
		"react-native",
		"ios",
		"android"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OP-Engineering/op-s2.git"
	},
	"author": "Oscar Franco <ospfranco@gmail.com> (https://github.com/ospfranco)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/OP-Engineering/op-s2/issues"
	},
	"homepage": "https://github.com/OP-Engineering/op-s2#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@evilmartians/lefthook": "^1.5.0",
		"@react-native-community/cli": "20.1.0",
		"@react-native/babel-preset": "0.87.0",
		"@release-it/conventional-changelog": "^9.0.2",
		"@types/jest": "^29.5.5",
		"@types/react": "^19.2.0",
		"commitlint": "^19.6.1",
		"del-cli": "^5.1.0",
		"jest": "^29.7.0",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"react": "19.2.3",
		"react-native": "0.87.0",
		"react-native-builder-bob": "^0.43.0",
		"release-it": "^17.10.0",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"workspaces": [
		"example"
	],
	"packageManager": "yarn@3.6.1",
	"engines": {
		"node": ">= 18.0.0"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			"commonjs",
			"module",
			[
				"typescript",
				{
					"project": "tsconfig.build.json"
				}
			]
		]
	}
}
